# Secrets — NEVER commit, template or instance (they live in Actions Secrets / keyring)
.env
secrets.env
*.secret

# Generated per-user RUN OUTPUTS are transient (ephemeral on CI runners) — never commit them.
# NOTE: in a PRIVATE instance repo the user's INPUTS (<user>/config.yaml + <user>/profile/ résumés)
# ARE committed — that's the instance model. Only the generated subdirs below are ignored.
*/postings_cache/
*/applications/
*/drafts/
*/packets/
*/log/
*/weekly_notes.txt
users/
data/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.playwright/

# The shared TEMPLATE tracks only config/user.example.yaml; an INSTANCE additionally commits its
# own <user>/config.yaml (kept out of config/, so this rule doesn't touch it) + <user>/profile/*.pdf.
config/*.yaml
!config/user.example.yaml
